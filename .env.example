# Mode data: "mock" (localStorage + BroadcastChannel) atau "firebase" (belum diimplementasikan).
VITE_DATA_MODE=mock

# Nomor WhatsApp owner (format internasional tanpa "+").
# Ganti placeholder ini dengan nomor asli agar tombol WhatsApp berfungsi.
VITE_OWNER_WHATSAPP=628xxxxxxxxxx

# Tarif sewa lapangan per jam (Rupiah).
VITE_PRICE_PER_HOUR=50000

# Nama venue yang tampil di aplikasi dan pesan WhatsApp.
VITE_VENUE_NAME=GOR Badminton
